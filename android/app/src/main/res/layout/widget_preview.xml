<?xml version="1.0" encoding="utf-8"?>
<!-- Как выглядит виджет в списке виджетов (пример данных) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="22 фо · Сегодня, 14 ноября"
        android:textColor="@color/w_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Дальше · в 10:40"
        android:textColor="@color/w_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Анатомия и физиология · каб. 13"
        android:textColor="@color/w_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="9:00  Общий уход за пациентами · 6&#10;10:40  Анатомия и физиология · 13&#10;12:40  История России · 6"
        android:textColor="@color/w_text"
        android:textSize="13sp" />
</LinearLayout>
